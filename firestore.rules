rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    // REGLAS DE SEGURIDAD — AutoCheck 360
    // ══════════════════════════════════════════════════════════════
    //
    // Principio de mínimo privilegio:
    // 1. Usuarios no autenticados: CERO acceso (bloqueo total).
    // 2. Usuarios autenticados:
    //    - Pueden leer la colección workshops para resolver su taller.
    //    - Solo pueden MODIFICAR su propio taller (workshopId / uid).
    //    - Solo pueden LEER y ESCRIBIR sus propias órdenes y turnos
    //      en workshops/{workshopId}/orders y appointments.
    //    - Ningún taller puede ver o editar las órdenes de otro taller.
    // ══════════════════════════════════════════════════════════════

    // ─── Regla por defecto: DENEGAR TODO ACCESO ────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── WORKSHOPS (talleres) ──────────────────────────────────
    match /workshops/{workshopId} {

      // Lectura permitida a usuarios autenticados para resolver su taller
      allow read: if request.auth != null;

      // Creación: Debe estar autenticado y registrar su propio UID
      allow create: if request.auth != null
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);

      // Actualización: Solo el dueño del taller puede actualizarlo.
      // Si el documento ya tiene UID, debe coincidir con el usuario autenticado.
      // Si no tiene UID (documento previo a la migración), se permite la adopción.
      allow update: if request.auth != null
        && (
          (resource.data.uid == request.auth.uid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid))
          ||
          (!('uid' in resource.data) || resource.data.uid == null)
        );

      // Eliminación: Bloqueada para prevenir borrado accidental de talleres
      allow delete: if false;

      // ─── ÓRDENES DE TRABAJO (subcolección aislada) ───────────
      match /orders/{orderId} {
        // Solo el dueño del taller padre puede leer o escribir sus órdenes
        allow read, write: if request.auth != null
          && (
            !exists(/databases/$(database)/documents/workshops/$(workshopId))
            || !('uid' in get(/databases/$(database)/documents/workshops/$(workshopId)).data)
            || get(/databases/$(database)/documents/workshops/$(workshopId)).data.uid == null
            || get(/databases/$(database)/documents/workshops/$(workshopId)).data.uid == request.auth.uid
          );
      }

      // ─── TURNOS / CITAS (subcolección aislada) ───────────────
      match /appointments/{appointmentId} {
        // Solo el dueño del taller padre puede leer o escribir sus turnos
        allow read, write: if request.auth != null
          && (
            !exists(/databases/$(database)/documents/workshops/$(workshopId))
            || !('uid' in get(/databases/$(database)/documents/workshops/$(workshopId)).data)
            || get(/databases/$(database)/documents/workshops/$(workshopId)).data.uid == null
            || get(/databases/$(database)/documents/workshops/$(workshopId)).data.uid == request.auth.uid
          );
      }
    }

    // ─── USER MAPPINGS (Mapeo auxiliar usuario → UID) ──────────
    match /userMappings/{mappingId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow delete: if false;
    }
  }
}
